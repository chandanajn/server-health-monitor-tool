# Root directory containing environment subdirectories and server log files
HM_ROOT=org

# Path to the state persistence checkpoint file (must be outside HM_ROOT)
HM_STATE_FILE=state/state.json

# Background scanning interval in seconds (minimum 0.1)
HM_INTERVAL=30.0

# Minimum severity threshold to record an active fault (INFO, WARN, ERROR, CRIT)
HM_MIN_SEVERITY=ERROR

# Optional API key for write endpoints (minimum 16 characters). If unset, write routes return 403.
# HM_API_KEY=change-me-to-a-secure-random-token-min-16-chars

# Log verbosity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
HM_LOG_LEVEL=INFO

# Application log format: text or json
HM_LOG_FORMAT=text

# Toggle interactive OpenAPI documentation at /docs
HM_ENABLE_DOCS=true

# Toggle Prometheus metrics export at /metrics
HM_ENABLE_METRICS=true

# Server host and port binding for direct execution (python -m health_api)
HM_HOST=127.0.0.1
HM_PORT=8000

